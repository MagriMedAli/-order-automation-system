      "id": "dbb89dec-cc47-4a8d-906b-7501e0c58820",
      "name": "Get Products"
    },
    {
      "parameters": {
        "jsCode": "const aiItems = $json.items;\nconst products = $('Get Products').all().map(item => item.json);\n\nconst items = aiItems.map(ai => {\n  const product = products.find(p =>\n    p.name.toLowerCase() === ai.product_name.toLowerCase()\n  );\n\n  if (!product) {\n    throw new Error(`Product not found: ${ai.product_name}`);\n  }\n\n  return {\n    product_id: product.id,\n    quantity: ai.quantity,\n    unit_price: product.price\n  };\n});\n\nlet phone = $('Extract WhatsApp Message').first().json.phone;\n\nif (phone.startsWith('216')) {\n  phone = phone.slice(3);\n}\n\nreturn [{\n  json: {\n    phone,\n    items\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
