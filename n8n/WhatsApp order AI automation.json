    {
      "parameters": {
        "jsCode": "const payload = $json.body;\n\nconst message = payload.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\n\nif (!message) {\n  return [{\n    json: {\n      type: \"ignored\",\n      reason: \"No WhatsApp message found\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    phone: message.from,\n    message: message.text?.body || \"\",\n    message_id: message.id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
