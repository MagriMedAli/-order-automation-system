        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Extract WhatsApp Message').first().json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Order confirmed! Your order #{{ $json.order_id }} has been created. Total: {{ $json.total }} TND.\"\n  }\n}",
